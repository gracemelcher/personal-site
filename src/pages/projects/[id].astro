---
// The template every project page uses. Each project file in
// src/content/projects fills it in, and its `pageLayout` picks how the page is arranged.
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SideLayout from '../../components/project/SideLayout.astro';
import ShowcaseLayout from '../../components/project/ShowcaseLayout.astro';
import Embed from '../../components/mdx/Embed.astro';
import Clip from '../../components/mdx/Clip.astro';
import ClipGrid from '../../components/mdx/ClipGrid.astro';
import Laptop from '../../components/mdx/Laptop.astro';
import { getProjects, type Project } from '../../data/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: {
      project,
      // Wraps around so the last project points back to the first.
      next: projects[(i + 1) % projects.length],
    },
  }));
}

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const { title, summary, cover, gallery, pageLayout } = project.data;
const { Content } = await render(project);

const galleryImages = await Promise.all(
  gallery.map(async (item) => ({
    ...item,
    // Enlarged view: the photo's own size, capped at 2000px wide
    full: (await getImage({ src: item.src, width: Math.min(item.src.width, 2000) })).src,
  })),
);

const Layout = pageLayout === 'showcase' ? ShowcaseLayout : SideLayout;
---

<BaseLayout title={title} description={summary} image={cover}>
  <Layout project={project} next={next} Content={Content} components={{ Embed, Clip, ClipGrid, Laptop }} gallery={galleryImages} />
</BaseLayout>
