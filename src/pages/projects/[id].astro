---
// The template every project page uses. Each project file in
// src/content/projects fills it in.
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Embed from '../../components/mdx/Embed.astro';
import Clip from '../../components/mdx/Clip.astro';
import ClipGrid from '../../components/mdx/ClipGrid.astro';
import { getProjects, projectUrl, type Project } from '../../data/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: {
      project,
      // Wraps around so the last project points back to the first.
      next: projects[(i + 1) % projects.length],
    },
  }));
}

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const { title, summary, description, facts, links, cover, coverAlt, showCover, gallery, theme } = project.data;
// Side-column text: one paragraph per blank line.
const paragraphs = (description ?? '').split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const { Content } = await render(project);

const galleryImages = await Promise.all(
  gallery.map(async (item) => ({
    ...item,
    // Enlarged view: the photo's own size, capped at 2000px wide
    full: (await getImage({ src: item.src, width: Math.min(item.src.width, 2000) })).src,
  })),
);

const themeStyle = theme.paper ? `--paper: ${theme.paper}` : undefined;
---

<BaseLayout title={title} description={summary} image={cover}>
  <article class="project container" style={themeStyle}>
    <aside class="side">
      <a class="back" href="/projects">← All projects</a>
      <h1>{title}</h1>

      {facts.length > 0 && (
        <dl class="facts">
          {facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      )}

      {paragraphs.map((p) => <p class="description">{p}</p>)}

      {links.length > 0 && (
        <div class="links">
          {links.map((l) => (
            <a href={l.url} target="_blank" rel="noopener">
              {l.label} ↗
            </a>
          ))}
        </div>
      )}

      {next.id !== project.id && (
        <a class="next" href={projectUrl(next)}>
          <span>Next</span>
          {next.data.title} →
        </a>
      )}
    </aside>

    <div class="media">
      {showCover && (
        <Image class="cover" src={cover} alt={coverAlt} widths={[640, 1280]} sizes="(max-width: 860px) 100vw, 640px" loading="eager" />
      )}

      <div class="body">
        <Content components={{ Embed, Clip, ClipGrid }} />
      </div>

      {galleryImages.length > 0 && (
        <section class="gallery" aria-label="Gallery">
          {galleryImages.map((item) => (
            <figure>
              <button type="button" data-full={item.full} data-alt={item.alt} aria-label={`Enlarge ${item.alt || 'image'}`}>
                <Image src={item.src} alt={item.alt} widths={[320, 640]} sizes="(max-width: 860px) 50vw, 310px" />
              </button>
              {item.caption && <figcaption>{item.caption}</figcaption>}
            </figure>
          ))}
        </section>
      )}

      {next.id !== project.id && (
        <a class="next next-bottom" href={projectUrl(next)}>
          <span>Next</span>
          {next.data.title} →
        </a>
      )}
    </div>
  </article>

  {galleryImages.length > 0 && (
    <dialog class="lightbox" id="lightbox">
      <form method="dialog"><button class="close" aria-label="Close">×</button></form>
      <img alt="" />
    </dialog>
  )}
</BaseLayout>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = dialog?.querySelector('img');
  document.querySelectorAll<HTMLButtonElement>('[data-full]').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!dialog || !img) return;
      img.src = btn.dataset.full!;
      img.alt = btn.dataset.alt ?? '';
      dialog.showModal();
    });
  });
  // Click outside the image to close.
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>

<style>
  /* Two columns: text stays put on the left while images scroll on the right */
  .project {
    display: grid;
    grid-template-columns: minmax(220px, 300px) minmax(0, 640px);
    justify-content: center;
    gap: clamp(40px, 6vw, 88px);
    padding-top: 32px;
    padding-bottom: 48px;
    background: var(--paper);
  }

  .side {
    position: sticky;
    top: 32px;
    align-self: start;
  }

  .back {
    display: inline-block;
    margin-bottom: 28px;
    font-size: 13px;
    text-decoration: none;
    color: var(--ink-soft);
  }

  .back:hover {
    color: var(--accent);
  }

  h1 {
    margin: 0;
    font-weight: var(--weight-title);
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .facts {
    margin: 24px 0 0;
  }

  .facts div + div {
    margin-top: 12px;
  }

  .facts dt {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .facts dd {
    margin: 2px 0 0;
    font-size: 14px;
  }

  .description {
    margin: 22px 0 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .description + .description {
    margin-top: 12px;
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 22px;
  }

  .links a {
    font-size: 14px;
    color: var(--ink);
    text-underline-offset: 3px;
  }

  .links a:hover {
    color: var(--accent);
  }

  .next {
    display: block;
    margin-top: 40px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-size: 18px;
    text-decoration: none;
  }

  .next span {
    display: block;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .next:hover {
    color: var(--accent);
  }

  .next-bottom {
    display: none;
  }

  /* The media column; its width lets clip grids size their tiles */
  .media {
    container-type: inline-size;
    padding-top: 52px;
  }

  .media > :global(.cover) {
    width: 100%;
    margin-bottom: 24px;
    border-radius: var(--radius);
  }

  .body :global(img),
  .body :global(video) {
    width: 100%;
    max-height: 78vh;
    object-fit: contain;
    border-radius: var(--radius);
  }

  /* Photos keep their own shape and stack in two columns, like a pinboard */
  .gallery {
    columns: 2;
    column-gap: 14px;
  }

  .body + .gallery {
    margin-top: 24px;
  }

  .gallery figure {
    margin: 0 0 14px;
    break-inside: avoid;
  }

  .gallery button {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .gallery :global(img) {
    width: 100%;
    transition: transform 0.4s ease;
  }

  .gallery button:hover :global(img) {
    transform: scale(1.03);
  }

  figcaption {
    margin-top: 6px;
    font-size: 13px;
    color: var(--ink-soft);
  }

  /* Phones and narrow windows: details on top, images below */
  @media (max-width: 860px) {
    .project {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      padding-top: 16px;
    }

    .side {
      position: static;
    }

    .media {
      padding-top: 0;
    }

    .side .next {
      display: none;
    }

    .next-bottom {
      display: block;
    }
  }

  .lightbox {
    max-width: 92vw;
    max-height: 92vh;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    overflow: visible;
  }

  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.8);
  }

  .lightbox img {
    max-width: 92vw;
    max-height: 92vh;
    width: auto;
    border-radius: var(--radius);
  }

  .close {
    position: absolute;
    top: -40px;
    right: 0;
    border: 0;
    background: none;
    color: #fff;
    font-size: 32px;
    line-height: 1;
    cursor: pointer;
  }
</style>
