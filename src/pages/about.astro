---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Content as Bio } from '../data/about.md';
import { site } from '../site.config';
// Your photo. Swap the file to change it.
import portrait from '../assets/about/me.jpg';

// Icons for the links in site.config.ts → socials, matched by label.
// Paths are from Simple Icons (24×24). A label without an icon shows as text.
const icons: Record<string, string> = {
  LinkedIn:
    'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.744 1.494-1.524 3.11-1.524 3.6 0 4.267 2.37 4.267 4.91v6.255zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  Strava:
    'M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169',
};
---

<BaseLayout title="About">
  <section class="container about">
    <Image
      class="portrait"
      src={portrait}
      alt={`${site.name} smiling on a gray couch with a laptop, under an orange road bike mounted on the wall`}
      widths={[300, 600]}
      sizes="(max-width: 700px) 220px, 300px"
      loading="eager"
      fetchpriority="high"
    />

    <div class="page">
      <div class="bio">
        <Bio />
      </div>

      {site.resume && (
        <p class="resume">
          <a class="button" href={site.resume} target="_blank" rel="noopener">Read my résumé ↗</a>
        </p>
      )}

      <section class="contact" aria-labelledby="contact-title">
        <h2 id="contact-title">Contact me</h2>
        <dl>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
          </div>
          {site.socials.length > 0 && (
            <div>
              <dt>Elsewhere</dt>
              <dd class="socials">
                {site.socials.map((s) => (
                  <a href={s.href} target="_blank" rel="noopener" aria-label={icons[s.label] ? s.label : undefined} title={s.label}>
                    {icons[s.label] ? (
                      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d={icons[s.label]} fill="currentColor" /></svg>
                    ) : (
                      s.label
                    )}
                  </a>
                ))}
              </dd>
            </div>
          )}
        </dl>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(180px, 280px) minmax(0, 620px);
    justify-content: center;
    gap: clamp(32px, 6vw, 80px);
    padding-top: 48px;
  }

  .about > :global(.portrait) {
    position: sticky;
    top: 32px;
    align-self: start;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }

  .bio {
    font-size: 18px;
    line-height: 1.7;
  }

  .bio :global(p) {
    margin: 0 0 1.1em;
  }

  /* Links in the bio look like highlighter marks */
  .bio :global(a) {
    text-decoration: none;
    background: linear-gradient(transparent 58%, var(--highlight) 58%);
    padding: 0 2px;
    transition: background 0.25s;
  }

  .bio :global(a:hover),
  .bio :global(a:focus-visible) {
    background: linear-gradient(transparent 0%, var(--highlight) 0%);
  }

  .resume {
    margin: 8px 0 0;
  }

  .contact {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .contact h2 {
    margin: 0 0 14px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .contact dl {
    margin: 0;
  }

  .contact div {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 16px;
    padding: 6px 0;
    font-size: 15px;
  }

  .contact dt {
    color: var(--ink-soft);
  }

  .contact dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .contact a {
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition: color 0.2s, border-color 0.2s;
  }

  .contact a:hover,
  .contact a:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
  }

  .contact .socials {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .contact .socials a {
    display: inline-flex;
    color: var(--ink-soft);
    border-bottom: 0;
  }

  @media (max-width: 700px) {
    .about {
      grid-template-columns: 1fr;
      padding-top: 16px;
    }

    .about > :global(.portrait) {
      position: static;
      max-width: 220px;
    }

    .bio {
      font-size: 17px;
    }

    .contact {
      margin-top: 48px;
    }

    .contact div {
      grid-template-columns: 80px minmax(0, 1fr);
    }
  }
</style>
