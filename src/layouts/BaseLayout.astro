---
import '../styles/theme.css';
import { getImage } from 'astro:assets';
import Nav from '../components/Nav.astro';
import { site } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  // Picture shown when the page is shared as a link (a project's cover).
  image?: ImageMetadata;
}

const { title, description = site.description, image } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const shareImage = image && new URL((await getImage({ src: image, width: 1200, format: 'jpg' })).src, Astro.site).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {shareImage && <meta property="og:image" content={shareImage} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@400..800&display=swap" />
    <!-- Caveat is only used for "gm", so download just those two letters -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500&text=gm&display=swap" />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <footer class="footer container">
      <span>© {new Date().getFullYear()} {site.name}</span>
    </footer>
  </body>
</html>

<style>
  main {
    min-height: calc(100vh - 160px);
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding-top: 48px;
    padding-bottom: 32px;
    font-size: 13px;
    color: var(--ink-faint);
  }
</style>
